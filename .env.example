# TypeSafe / Jev System One API
TYPESAFE_API_KEY=apikey_your_key_here
JEV_API_KEY=apikey_your_key_here
JEV_API_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# Optional: pin RL UI agent checkpoints (absolute path or relative to repo root)
# Defaults to runs/current_best/checkpoints/best.pt when unset.
RL_CHECKPOINT=runs/current_best/checkpoints/best.pt
# RL_FIRST_CHECKPOINT=runs/parallel_smoke/checkpoints/best.pt
